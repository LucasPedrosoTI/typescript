{
  "name": "app-gestao",
  "version": "0.0.0",
  "private": true,
  "main": "build/app.js",
  "scripts": {
    "prebuild": "tslint -c tslint.json -p tsconfig.json --fix",
    "start": "node .",
    "build": "tsc",
    "dev": "tsnd --transpile-only --ignore-watch node_modules --respawn ./src/app.ts",
    "migrate": "knex --knexfile knexfile.ts migrate:latest",
    "rollback": "knex --knexfile knexfile.ts migrate:rollback",
    "seed": "knex --knexfile knexfile.ts seed:run",
    "db": "yarn migrate && yarn seed"
  },
  "dependencies": {
    "@types/app-root-path": "^1.2.4",
    "app-root-path": "^3.0.0",
    "bcrypt": "^5.0.0",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^8.2.0",
    "express": "~4.16.1",
    "jsonwebtoken": "^8.5.1",
    "knex": "^0.21.4",
    "morgan": "~1.9.1",
    "mysql2": "^2.1.0",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^3.0.0",
    "@types/cookie-parser": "^1.4.2",
    "@types/cors": "^2.8.7",
    "@types/debug": "^4.1.5",
    "@types/express": "^4.17.7",
    "@types/jsonwebtoken": "^8.5.0",
    "@types/morgan": "^1.9.1",
    "@types/node": "^14.0.27",
    "ts-node-dev": "^1.0.0-pre.57",
    "tslint": "^6.1.3",
    "typescript": "^3.9.7"
  }
}
